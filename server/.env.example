# Copy this file to .env and fill in real values.
# This project does NOT auto-load .env by itself - see README.md for how to
# export these into your shell (or your IDE's run configuration) before
# running the app.

# MongoDB connection string (local, Atlas, etc.)
MONGODB_URI=mongodb://localhost:27017/siranaba

# Google Gemini API key - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# JWT signing secret - generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=1440

# Front end dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo tenant seeded on first run (matches the old mock data's "Alex Rivers")
SEED_DEMO_DATA=true
DEMO_EMAIL=admin@siranaba.com
DEMO_PASSWORD=Pass123

PORT=8080
